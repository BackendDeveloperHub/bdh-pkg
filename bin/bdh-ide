#!/bin/sh
# =========================================================
# 🚀 BDH Linux IDE - Automated Setup & Launcher (Pure C)
# =========================================================

# கம்பைல் செய்யப்பட்ட பைனரி உள்ள உங்களது bdh-pkg ரெப்போவின் Raw லிங்க்
BIN_URL="https://raw.githubusercontent.com/BackendDeveloperHub/bdh-pkg/main/bin/bdh-linux-ide"
APP_DIR="/bdh_drive/apps"
CORE_BIN="/bin/bdh-ide-core"

B="\033[1;34m"
G="\033[1;32m"
R="\033[1;31m"
Y="\033[1;33m"
W="\033[0m"

echo -e "${B}::${W} Initializing BDH Linux Workspace..."

# 1. First Time Setup (கம்பைல் செய்யப்பட்ட பைனரியை டவுன்லோட் செய்தல்)
if [ ! -f "$CORE_BIN" ]; then
    echo -e "${Y}==>${W} First run detected! Downloading BDH Pure C Engine..."
    
    mkdir -p "$APP_DIR"
    
    # git, make-க்கு பதிலாக நேரடியாக பைனரியை wget செய்கிறோம்
    wget -q -O "$APP_DIR/bdh-ide-core" "$BIN_URL" 2>/dev/null
    
    # டவுன்லோட் ஆனதை உறுதி செய்தல்
    if [ -s "$APP_DIR/bdh-ide-core" ]; then
        chmod +x "$APP_DIR/bdh-ide-core"
        ln -sf "$APP_DIR/bdh-ide-core" "$CORE_BIN"
        echo -e "${G}==>${W} C-Engine configured successfully!"
    else
        echo -e "${R}==>${W} Error: Failed to download IDE binary from repository!"
        rm -f "$APP_DIR/bdh-ide-core"
        exit 1
    fi
fi

# 2. Launching the Environment (C Engine-ஐ ரன் செய்தல்)
echo -e "${G}==>${W} Launching BDH-IDE..."
exec bdh-ide-core
